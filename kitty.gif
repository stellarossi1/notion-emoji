<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cute Pink Cat Widget</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html, body {
      width: 100%;
      height: 100%;
      background: transparent;
      overflow: hidden;
    }

    body {
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .cat-container {
      width: 100%;
      max-width: 180px;
      height: auto;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    svg {
      width: 100%;
      height: auto;
    }

    /* --- ANIMAZIONI CSS FLUIDE --- */

    /* 1. Movimento dolce e naturale della testa */
    #head-group {
      transform-origin: 150px 180px;
      animation: headTilt 5s ease-in-out infinite;
    }

    @keyframes headTilt {
      0%, 100% { transform: rotate(0deg); }
      30% { transform: rotate(-4deg); }
      70% { transform: rotate(5deg); }
    }

    /* 2. Battito d'occhi naturale (senza lag) */
    .eye {
      transform-origin: 122px 148px;
      animation: naturalBlink 4s ease-in-out infinite;
    }

    #eye-right {
      transform-origin: 178px 148px;
    }

    @keyframes naturalBlink {
      0%, 90%, 100% {
        transform: scaleY(1);
      }
      93% {
        transform: scaleY(0.08); /* Si chiudono a fessura in modo fluido */
      }
    }

    /* 3. Lieve scodinzolio della coda */
    #tail {
      transform-origin: 220px 220px;
      animation: wagTail 4s ease-in-out infinite alternate;
    }

    @keyframes wagTail {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(-6deg); }
    }
  </style>
</head>
<body>

  <div class="cat-container">
    <svg viewBox="0 0 300 320" fill="none" xmlns="http://www.w3.org/2000/svg">
      
      <!-- Coda -->
      <g id="tail">
        <path d="M 220 220 C 240 210, 255 190, 250 165 C 245 150, 230 155, 235 170 C 238 180, 225 195, 210 205 Z" fill="#FFFFFF" stroke="#2B0E1E" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M 242 175 C 248 168, 250 160, 245 155 C 238 155, 235 165, 238 172 Z" fill="#F3A4B5"/>
      </g>

      <!-- Corpo e Zampe -->
      <g id="body-group">
        <!-- Sagoma Corpo -->
        <path d="M 100 210 C 90 230, 95 280, 120 290 C 135 295, 165 295, 180 290 C 205 280, 210 230, 200 210 Z" fill="#FFFFFF" stroke="#2B0E1E" stroke-width="3.5"/>
        
        <!-- Macchia Zampa -->
        <path d="M 185 260 C 200 265, 202 280, 190 285 C 180 280, 180 270, 185 260 Z" fill="#F3A4B5" opacity="0.8"/>
        
        <!-- Zampe Anteriori -->
        <path d="M 115 220 C 110 250, 115 285, 130 290 C 140 290, 145 280, 142 220" fill="#FFFFFF" stroke="#2B0E1E" stroke-width="3.5" stroke-linecap="round"/>
        <path d="M 185 220 C 190 250, 185 285, 170 290 C 160 290, 155 280, 158 220" fill="#FFFFFF" stroke="#2B0E1E" stroke-width="3.5" stroke-linecap="round"/>
        
        <!-- Dita zampe -->
        <path d="M 123 282 L 123 290 M 132 282 L 132 290" stroke="#2B0E1E" stroke-width="2.5" stroke-linecap="round"/>
        <path d="M 168 282 L 168 290 M 177 282 L 177 290" stroke="#2B0E1E" stroke-width="2.5" stroke-linecap="round"/>

        <!-- Collarino Rosa con Cuore -->
        <path d="M 102 212 C 120 222, 180 222, 198 212 C 202 220, 195 227, 150 230 C 105 227, 98 220, 102 212 Z" fill="#F8B1C4" stroke="#2B0E1E" stroke-width="3"/>
        <!-- Cuore -->
        <path d="M 150 224 C 146 218, 138 222, 150 234 C 162 222, 154 218, 150 224 Z" fill="#E85D82" stroke="#2B0E1E" stroke-width="2.5"/>
      </g>

      <!-- TESTA (Identica all'immagine) -->
      <g id="head-group">
        <!-- Orecchia Sinistra -->
        <path d="M 85 105 C 75 45, 105 45, 128 75 Z" fill="#FFFFFF" stroke="#2B0E1E" stroke-width="3.5" stroke-linejoin="round"/>
        <path d="M 93 95 C 88 58, 105 58, 120 78 Z" fill="#F8B1C4"/>

        <!-- Orecchia Destra -->
        <path d="M 215 105 C 225 45, 195 45, 172 75 Z" fill="#FFFFFF" stroke="#2B0E1E" stroke-width="3.5" stroke-linejoin="round"/>
        <path d="M 207 95 C 212 58, 195 58, 180 78 Z" fill="#F8B1C4"/>

        <!-- Sagoma Testa -->
        <path d="M 75 145 C 65 190, 110 215, 150 215 C 190 215, 235 190, 225 145 C 220 100, 190 80, 150 80 C 110 80, 80 100, 75 145 Z" fill="#FFFFFF" stroke="#2B0E1E" stroke-width="3.5"/>

        <!-- Macchioline Rosa Testa -->
        <path d="M 130 83 C 140 82, 160 85, 165 92 C 150 100, 135 95, 130 83 Z" fill="#F3A4B5" opacity="0.85"/>
        <ellipse cx="120" cy="98" rx="4" ry="2.5" fill="#F3A4B5" opacity="0.85"/>
        <ellipse cx="170" cy="96" rx="3" ry="2" fill="#F3A4B5" opacity="0.85"/>
        <ellipse cx="178" cy="103" rx="2" ry="1.5" fill="#F3A4B5" opacity="0.85"/>

        <!-- Guance Rosa -->
        <ellipse cx="110" cy="172" rx="14" ry="9" fill="#F8A5B9"/>
        <ellipse cx="190" cy="172" rx="14" ry="9" fill="#F8A5B9"/>

        <!-- Baffi -->
        <path d="M 60 152 L 90 156 M 55 168 L 88 166 M 62 182 L 92 174" stroke="#2B0E1E" stroke-width="3" stroke-linecap="round"/>
        <path d="M 240 152 L 210 156 M 245 168 L 212 166 M 238 182 L 208 174" stroke="#2B0E1E" stroke-width="3" stroke-linecap="round"/>

        <!-- Nasino e Bocca Originale (Fissa e Pulita) -->
        <path d="M 147 160 C 147 157, 153 157, 153 160 C 153 163, 147 163, 147 160 Z" fill="#E85D82" stroke="#2B0E1E" stroke-width="1.5"/>
        <path d="M 138 167 C 145 174, 150 170, 150 167 C 150 170, 155 174, 162 167" stroke="#2B0E1E" stroke-width="3" stroke-linecap="round" fill="none"/>

        <!-- OCCHI APERTI (Animati con contrazione fluida) -->
        <g id="eye-left" class="eye">
          <ellipse cx="122" cy="148" rx="13" ry="16" fill="#2B0E1E"/>
          <circle cx="118" cy="142" r="5" fill="#FFFFFF"/>
          <circle cx="125" cy="153" r="2" fill="#FFFFFF"/>
          <path d="M 112 136 C 110 130, 115 132, 115 132 M 122 132 L 122 127 M 130 135 C 133 130, 131 133, 131 133" stroke="#2B0E1E" stroke-width="2.5" stroke-linecap="round"/>
        </g>

        <g id="eye-right" class="eye">
          <ellipse cx="178" cy="148" rx="13" ry="16" fill="#2B0E1E"/>
          <circle cx="174" cy="142" r="5" fill="#FFFFFF"/>
          <circle cx="181" cy="153" r="2" fill="#FFFFFF"/>
          <path d="M 170 135 C 168 130, 170 133, 170 133 M 178 132 L 178 127 M 186 136 C 189 130, 185 132, 185 132" stroke="#2B0E1E" stroke-width="2.5" stroke-linecap="round"/>
        </g>

      </g>
    </svg>
  </div>

</body>
</html>
